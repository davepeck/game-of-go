DJANGO_SECRET_KEY=change-me
# DEBUG defaults to true; set to false in production (dokku config:set).
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=go.davepeck.dev,localhost,127.0.0.1

# For production only; leave unset locally to use sqlite:///db.sqlite3.
DATABASE_URL=postgres://user:pass@localhost:5432/gameofgo

GO_BASE_URL=https://go.davepeck.dev/
DEFAULT_FROM_EMAIL=Dave Peck's Go <go@davepeck.dev>

# Mailgun via SMTP. Leave EMAIL_BACKEND unset locally to fall back to the
# console backend (mails print to stdout). Use smtp.eu.mailgun.org if your
# Mailgun account is in the EU region.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.mailgun.org
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=postmaster@davepeck.dev
EMAIL_HOST_PASSWORD=
