DJANGO_SECRET_KEY=change-me
# DEBUG defaults to true; set to false in production (dokku config:set).
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=go.davepeck.org,localhost,127.0.0.1

# For production only; leave unset locally to use sqlite:///db.sqlite3.
DATABASE_URL=postgres://user:pass@localhost:5432/gameofgo

GO_BASE_URL=https://go.davepeck.org/
DEFAULT_FROM_EMAIL=Dave Peck's Go <no-reply@go.davepeck.org>

# Postmark (via django-anymail); swap for SES/Resend if preferred
ANYMAIL_POSTMARK_SERVER_TOKEN=
EMAIL_BACKEND=anymail.backends.postmark.EmailBackend
